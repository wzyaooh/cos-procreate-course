# 网站域名（不要带 http://），改成你自己的。写进分享卡片和 sitemap。
SITE_DOMAIN=example.com

# 运行模式：
#   :80        前面有 nginx / 1Panel OpenResty 反代（默认）。容器只在本机 127.0.0.1:8080 提供 HTTP，证书由 nginx 管
#   你的域名   不用 nginx，Caddy 直接对外并自动申请证书。还要把 docker-compose.yml 的 ports 换成注释里的那三行
CADDY_SITE=:80

# 反代模式下容器在本机监听的端口（8080 被占用时改这里，nginx 的代理地址也要跟着改）
LOCAL_PORT=8080

# ---------- 匿名使用统计（可选，说明见 docs/stats.md） ----------
# 开启：下面两行都要改。COMPOSE_PROFILES=stats 让 docker compose 启动统计服务，STATS_ENABLED=1 让页面加载统计脚本
# COMPOSE_PROFILES=stats
STATS_ENABLED=0
# 按设备的原始记录保留几天（每日汇总一直保留）
STATS_RETENTION_DAYS=2
# 看板密码：运行 python3 tools/stats_password.py，把输出的两行贴在这里
STATS_PASSWORD_HASH=
STATS_SECRET=
